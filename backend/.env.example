# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
DB_URL=mongodb://127.0.0.1:27017/blogDatabase

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Options:
# OPTION A (Recommended for Render Free Tier): Use Resend HTTP API over Port 443 (HTTPS)
# Standard SMTP ports (25, 465, 587) are blocked on Render free tier.
# Free sandbox sender is "onboarding@resend.dev" (or "eWrite <onboarding@resend.dev>")
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# OPTION B: Auto-verify emails directly without an email service (instant signup testing)
# AUTO_VERIFY_EMAIL=true

# OPTION C: Standard SMTP / Gmail App Password (for local development or paid hosting with open SMTP ports)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@gmail.com

# Firebase Admin SDK
# 1. Project ID (Required for Google Sign-In ID Token verification)
FIREBASE_PROJECT_ID=ewrite-fe5d3

# 2. Service Account Credentials (Optional on cloud platforms if only verifying ID tokens, but recommended):
# Single-line JSON or Base64 JSON:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ewrite-fe5d3"}
# Or individual credentials:
# FIREBASE_CLIENT_EMAIL=your_service_account_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
